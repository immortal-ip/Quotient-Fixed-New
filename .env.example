# ─────────────────────────────────────────────
#  Quotient Bot - Environment Variables
#  Copy this file to src/.env and fill it in
# ─────────────────────────────────────────────

# REQUIRED: Your Discord bot token (from https://discord.com/developers)
DISCORD_TOKEN=your_discord_bot_token_here

# REQUIRED: PostgreSQL connection URL
# Format: postgresql://user:password@host:5432/dbname
# Termux local example: postgresql://quotient:password@localhost:5432/quotient
DATABASE_URL=postgresql://user:password@localhost:5432/quotient

# ── Bot Settings (optional) ──────────────────
BOT_COLOR=0x00FFB3
BOT_FOOTER=Quotient
BOT_PREFIX=q

# ── Optional Links ────────────────────────────
SERVER_LINK=
BOT_INVITE=
WEBSITE=
REPOSITORY=https://github.com/quotientbot/Quotient-Bot

# ── Developer Discord User IDs (comma separated) ──
DEVS=

# ── Log Webhook URLs (optional) ──────────────
# These must be valid Discord webhook URLs or leave empty
SHARD_LOG=
ERROR_LOG=
PUBLIC_LOG=
GUILD_LOGS=

# ── OCR Service (optional - for screenshot verification) ──
FASTAPI_URL=
FASTAPI_KEY=

# ── Server-specific IDs (optional) ───────────
SERVER_ID=0
VOTER_ROLE=0
PREMIUM_ROLE=0

# ── Premium (optional) ────────────────────────
PAY_LINK=
PRO_LINK=
PREMIUM_AVATAR=
PRIME_EMOJI=⭐
