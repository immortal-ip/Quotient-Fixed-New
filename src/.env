# ─────────────────────────────────────────────
#  Quotient Bot - Environment Variables
#  Copy this file to src/.env and fill it in
# ─────────────────────────────────────────────

# REQUIRED: Your Discord bot token (from https://discord.com/developers)
DISCORD_TOKEN=Your Token here 

# REQUIRED: PostgreSQL connection URL
# Format: postgresql://user:password@host:5432/dbname
# Termux local example: postgresql://quotient:password@localhost:5432/quotient
DATABASE_URL=Your Db here
# ── Bot Settings (optional) ──────────────────────────
BOT_COLOR=0x00FFB3
BOT_FOOTER=Quo x
BOT_PREFIX=q

# ── Optional Links ────────────────────────────
SERVER_LINK=https://discord.gg/w3VT9TYcm
BOT_INVITE=https://discord.gg/w3VT9TYcm
WEBSITE=https://quotientbot.com/
REPOSITORY=https://github.com/quotientbot/Quotient-Bot

# ── Developer Discord User IDs (comma separated) ──
DEVS=1363724949939814423

# ── Log Webhook URLs (optional) ──────────────
# These must be valid Discord webhook URLs or leave empty
SHARD_LOG=https://discord.com/api/webhooks/1537844414788149298/WO3LbLMPs9FdiTcivrjcv75d0ddsbUntG9aP2srkMcyjBhvp-TILzgK64SexBNCZ3wz7
ERROR_LOG=https://discord.com/api/webhooks/1537844414788149298/WO3LbLMPs9FdiTcivrjcv75d0ddsbUntG9aP2srkMcyjBhvp-TILzgK64SexBNCZ3wz7
PUBLIC_LOG=https://discord.com/api/webhooks/1537844414788149298/WO3LbLMPs9FdiTcivrjcv75d0ddsbUntG9aP2srkMcyjBhvp-TILzgK64SexBNCZ3wz7
GUILD_LOGS=https://discord.com/api/webhooks/1537844414788149298/WO3LbLMPs9FdiTcivrjcv75d0ddsbUntG9aP2srkMcyjBhvp-TILzgK64SexBNCZ3wz7

# ── OCR Service (optional - for screenshot verification) ──
FASTAPI_URL=
FASTAPI_KEY=

# ── Server-specific IDs (optional) ───────────
SERVER_ID=
VOTER_ROLE=0
PREMIUM_ROLE=0

# ── Premium (optional) ────────────────────────
PAY_LINK=
PRO_LINK=
PREMIUM_AVATAR=
PRIME_EMOJI=⭐
